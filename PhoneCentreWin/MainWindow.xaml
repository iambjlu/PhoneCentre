<Window x:Class="PhoneCentre.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="Black">
    <Image x:Name="Video" Stretch="Uniform"/>
    <Border x:Name="Surface" Background="Transparent"/>
    <TextBlock x:Name="Status" Foreground="White" Opacity="0.8" Margin="12"
               VerticalAlignment="Top" HorizontalAlignment="Left" TextWrapping="Wrap"/>
  </Grid>
</Window>
